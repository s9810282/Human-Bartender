          "seq": 11,
          "type": "say",
          "actor": "shiba",
          "arg": "idle",
          "text": {
            "ko": "딱 보면 시바잖아, 시바.",
            "en": "One look and you can tell I'm a shiba, shiba."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
