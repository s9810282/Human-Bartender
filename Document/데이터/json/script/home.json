{
  "place": "home",
  "scenes": [
    {
      "id": "np_tv_1",
      "day": null,
      "phase": "home",
      "seq": 1,
      "trigger": "interact",
      "when": "!flag.tv_seen1",
      "title": "홀로그램 TV — 실종 뉴스 (구 radio 이식)",
      "skippable": false,
      "group": "home_tv",
      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "최근 B구역 일대에서 실종 사건이\n급격히 증가하고 있습니다.",
            "en": "Disappearances are rising sharply\nacross District B."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "지난 일주일에만 30명이 넘는 실종자가 발생하며\n전례 없는 연쇄 실종 사건으로 번지고 있습니다.",
            "en": "With over thirty people missing in the past week alone,\nit is escalating into an unprecedented serial-disappearance case."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "KCPD는 추가 인력을 급파해\n집중 수사에 착수했다고 밝혔습니다.",
            "en": "The KCPD has dispatched additional officers\nand launched a focused investigation."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(…실종. 기록해 둔다.)",
            "en": "(...Disappearances. Noted.)"
          },
          "when": null,
          "effects": "flag.tv_seen1 = true",
          "sync": "wait"
        }
      ]
    },
    {
      "id": "np_tv_2",
      "day": null,
      "phase": "home",
      "seq": 2,
      "trigger": "interact",
      "when": "",
      "title": "홀로그램 TV — 토크쇼 (구 radio 이식)",
      "skippable": false,
      "group": "home_tv",
      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "몇 달 전 북한산 저수지의 큰불, 기억하시죠?",
            "en": "Remember that huge fire at the Bukhansan reservoir a few months back?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "그게 단순한 산불이 아니었다는\n소문이 돌고 있습니다.",
            "en": "Word is going around that it was\nno ordinary wildfire."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(…이 도시는 소문이 많다.)",
            "en": "(...This city is full of rumors.)"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
    {
      "id": "d1_home_talk",
      "day": 0,
      "phase": "home",
      "seq": 1,
      "trigger": "auto",
      "when": "",
      "title": "테라스 — 바텐더의 태도 + 근황",
      "skippable": false,
      "group": "",
      "steps": [
        {
          "seq": 1,
          "type": "fx",
          "actor": null,
          "arg": "terrace_night",
          "text": null,
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…안 자고 있었나.",
            "en": "...Still up?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "잠이 안 와서요.",
            "en": "Couldn't sleep."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "바텐더는 별별 손님을 다 만난다. 취한 놈, 우는 놈, 말 없는 놈. 무슨 일이 있어도 잔을 만드는 손은 흔들리지 마라.",
            "en": "A bartender meets every kind of guest. Drunk ones, crying ones, silent ones. Whatever happens, the hand that makes the drink must not shake."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…이 집은 지낼 만하고?",
            "en": "...Is this place livable, by the way?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "choice",
          "actor": null,
          "arg": "ch_d1_home",
          "text": null,
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "그래. 천천히 하면 된다. 늦잠 자지 마라.",
            "en": "Good. Take it slow. And don't oversleep."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
    {
      "id": "d2_home_talk",
      "day": 1,
      "phase": "home",
      "seq": 1,
      "trigger": "auto",
      "when": "",
      "title": "테라스 — 이틀째 밤",
      "skippable": false,
      "group": "",
      "steps": [
        {
          "seq": 1,
          "type": "fx",
          "actor": null,
          "arg": "terrace_night",
          "text": null,
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…이틀째다. 오늘은 어땠나.",
            "en": "...Day two. How was it."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "손님이 많았습니다. …사람들은, 전부 다르네요.",
            "en": "There were many guests. ...People are all different."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "그래. 같은 잔을 시켜도 이유는 전부 다르다.",
            "en": "Right. Even when they order the same glass, the reasons are never the same."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "그걸 읽는 게 이 일의 절반이야.",
            "en": "Reading that is half of this job."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…나머지 절반은요?",
            "en": "...And the other half?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "기다리는 거다. 손님이 먼저 말할 때까지.",
            "en": "Waiting. Until the guest speaks first."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 8,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(기다린다… 기록해 둔다.)",
            "en": "(Waiting... noted.)"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
    {
      "id": "d3_home_talk",
      "day": 3,
      "phase": "home",
      "seq": 1,
      "trigger": "auto",
      "when": "!flag.samho_death_route && !flag.samho_refused_drink",
      "title": "테라스 — 은인들 (데모에선 분기 씬이 대체)",
      "skippable": false,
      "group": "",
      "steps": [
        {
          "seq": 1,
          "type": "fx",
          "actor": null,
          "arg": "terrace_night",
          "text": null,
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "아일리는 만났나.",
            "en": "Did you meet Aili."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "네. …포트 씨가 절 데려왔고, 아일리 씨가 고쳤다고 들었어요.",
            "en": "Yes. ...I heard Port brought me in, and Aili fixed me."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "그래. 그 둘한테는 빚이 있다. 나도, 너도.",
            "en": "Right. We owe those two. Both of us."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…크리스 씨는, 왜 절 받아준 거예요?",
            "en": "...Chris. Why did you take me in?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "……。",
            "en": "......"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…그 얘긴 아직이다. 때가 되면 말해주지.",
            "en": "...Not yet. When it's time, I'll tell you."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 9,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "일은 좀 어떠냐. 사흘 해보니.",
            "en": "How's the work? Three days in."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 10,
          "type": "choice",
          "actor": null,
          "arg": "ch_d3_home",
          "text": null,
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 11,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…그래. 그거면 됐다.",
            "en": "...Good. That's enough for me."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
    {
      "id": "d3_chris_witness",
      "day": 3,
      "phase": "home",
      "seq": 2,
      "trigger": "auto",
      "when": "flag.samho_refused_drink",
      "title": "크리스의 목격 — 데모 컷",
      "skippable": false,
      "group": "",
      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(소파에 삼호를 앉혔다. 상처는 깊지 않다.)",
            "en": "(I sat Samho on the sofa. The wound isn't deep.)"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…루나. 그건 뭐냐.",
            "en": "...Luna. What is that."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "samho",
          "arg": "default",
          "text": {
            "ko": "아… 안녕하세요! 삼호라고 합니다!",
            "en": "Ah... hello! Samho, sir!"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "………",
            "en": "........."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "사정이 있었습니다. 오늘 하루만—",
            "en": "There were circumstances. Just for tonight—"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "………",
            "en": "........."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…구급상자는 선반 위에 있다.",
            "en": "...The first-aid kit is on the shelf."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 8,
          "type": "say",
          "actor": "samho",
          "arg": "default",
          "text": {
            "ko": "…!",
            "en": "...!"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 9,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(…화내지 않았다.)",
            "en": "(...He didn't get angry.)"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 10,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "얘기는 내일 듣지. …길어질 것 같으니까.",
            "en": "We'll talk tomorrow. ...It sounds like a long story."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    }
  ],
