    {
      "id": "d1_intro",
      "day": 0,
      "phase": "intro",
      "seq": 1,
      "trigger": "auto",
      "when": "",
      "title": "인트로 — 검은 화면, 루나가 처음 눈뜨던 밤",
      "skippable": false,
      "group": "",
      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…정신이 드나.",
            "en": "...You're awake."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…여기는.",
            "en": "...Where is this."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "내 집이다. 포트라는 노인이 널 업어왔지.\n골목에 쓰러져 있었다더군.",
            "en": "My home. An old man named Port carried you in.\nSaid you were collapsed in an alley."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…당신은, 누구죠.",
            "en": "...And you are?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "크리스. 바 '언노운'의 마스터다.",
            "en": "Chris. Master of Bar Unknown."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "저는… 기억이, 없습니다.\n이름 말고는, 아무것도.",
            "en": "I... don't remember anything.\nNothing but my name."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "…그런 것 같더군.",
            "en": "...So it seems."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 8,
          "type": "say",
          "actor": "chris",
          "arg": "default",
          "text": {
            "ko": "당분간 여기 있어라.\n마침 가게에 일할 손이 필요하던 참이다.",
            "en": "Stay here for now.\nAs it happens, I need an extra pair of hands at the bar."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 9,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(…그렇게, 이 집의 소파가 내 자리가 되었다.)",
            "en": "(...And so, the sofa in this house became my place.)"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
