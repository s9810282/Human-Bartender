  "dialogue_scenes": [
    {
      "id": "sc_bark_announce",
      "steps": [
        { "actor": "lab_announcer", "channel": "bark", "bubble": "screen",
          "text_ko": "경고. 3구역 격리 프로토콜 해제.",
          "text_en": "Warning. Sector 3 containment protocol released." }
      ]
    },
    {
      "id": "sc_entry_pause",
      "steps": [
        { "actor": "hound", "expression": "neutral", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "찾았다. 시제품.",
          "text_en": "Found you, prototype." },
        { "actor": "luna", "expression": "fear", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "…또 이 꿈이야.",
          "text_en": "...This dream again." }
      ]
    },
    {
      "id": "sc_lab_talk",
      "steps": [
        { "actor": "hound", "expression": "neutral", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "명령이다. 얌전히 따라와라.",
          "text_en": "Orders are orders. Come quietly." },
        { "actor": "luna", "expression": "alert", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "싫다면?",
          "text_en": "And if I refuse?" },
        { "actor": "hound", "expression": "angry", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "선택지는 처음부터 없었다.",
          "text_en": "You never had a choice to begin with." },
        { "actor": "luna", "expression": "alert", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "그건 네 생각이고.",
          "text_en": "That's what you think." }
      ]
    },
    {
      "id": "sc_bark_hound_search",
      "steps": [
        { "actor": "hound", "channel": "bark", "bubble": "world",
          "text_ko": "어디 숨었지.",
          "text_en": "Where are you hiding." }
      ]
    },
    {
      "id": "sc_bark_hound_stop",
      "steps": [
        { "actor": "hound", "channel": "bark", "bubble": "world",
          "text_ko": "멈춰!",
          "text_en": "Stop!" }
      ]
    },
    {
      "id": "sc_run_pause",
      "steps": [
        { "actor": "hound", "expression": "angry", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "어디까지 갈 수 있을 것 같나.",
          "text_en": "How far do you think you can run." },
        { "actor": "luna", "expression": "alert", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "여기만 아니면, 어디든.",
          "text_en": "Anywhere but here." }
      ]
    },
    {
      "id": "sc_epilogue",
      "steps": [
        { "actor": "", "channel": "narration", "bubble": "screen", "advance": "auto", "auto_delay": 2.0,
          "text_ko": "— 이 꿈은 언제나 같은 질문으로 끝난다.",
          "text_en": "— This dream always ends with the same question." },
        { "actor": "luna", "expression": "relief", "channel": "main", "bubble": "world", "advance": "input",
          "text_ko": "숨을지, 도망칠지. …결국 고르는 건 나야.",
          "text_en": "Hide, or run. ...In the end, the choice is mine." }
      ]
    }
  ],

  "choices": [
    {
