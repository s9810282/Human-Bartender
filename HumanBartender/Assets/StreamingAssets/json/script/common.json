          "type": "say",
          "actor": "radio",
          "arg": "default",
          "text": {
            "ko": "KCPD는 추가 인력을 급파해\n집중 수사에 착수했다고 밝혔습니다.",
            "en": "The KCPD has dispatched additional officers\nand launched a focused investigation."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "(…실종. 기록해 둔다.)",
            "en": "(...Disappearances. Noted.)"
          },
          "when": null,
          "effects": "flag.tv_seen1 = true",
          "sync": "wait"
        }
      ]
