        {
          "seq": 3,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "이제 더 대화할 대사 데이터도 없단 말이야.",
            "en": "I'm out of dialogue data, that's why."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…?",
            "en": "...?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "불만 있으면 이런 정신 나간 게임을 기획한\nPD한테 가서 따져, 시바.",
            "en": "Got complaints? Take it up with the PD\nwho designed this insane game, shiba."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        }
      ]
    },
    {
