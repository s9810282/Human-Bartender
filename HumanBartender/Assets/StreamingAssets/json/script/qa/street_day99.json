      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": null,
          "dialogue_id": "dlg_qa_step_probe_001",
          "arg": null,
          "text": {
            "ko": "테스트용 간식 보관함에서 포장된 강아지 간식 한 개를 꺼냈다.",
            "en": "You take one sealed dog treat from the test container."
