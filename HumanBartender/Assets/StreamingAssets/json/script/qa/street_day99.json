          "when": null,
          "effects": "flag.qa_has_snack = true",
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": null,
          "dialogue_id": "dlg_qa_step_probe_002",
          "arg": null,
          "text": {
            "ko": "이제 간식을 가지고 있다. 옆의 행인과 대화하면 조건부 선택지를 사용할 수 있다.",
            "en": "You now have a treat. Talk to the nearby passerby to use the conditional option."
          },
          "when": "flag.qa_has_snack",
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": null,
          "dialogue_id": "dlg_qa_step_probe_003",
          "arg": null,
          "text": {
            "ko": "보관함은 잠겨 있어 간식을 꺼낼 수 없다.",
            "en": "The container is locked, so you cannot take a treat."
          },
          "when": "!flag.qa_has_snack",
          "effects": null,
          "sync": "wait"
        }
      ]
