    {
      "id": "np_shiba_1",
      "day": 0,
      "phase": "street",
      "seq": 1,
      "trigger": "interact",
      "when": "!flag.shiba_met",
      "title": "[이식] 시바 첫 조우 (구 first_encounter)",
      "skippable": false,
      "group": "np_shiba",
      "steps": [
        {
          "seq": 1,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…",
            "en": "..."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 2,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "뭘 봐? 시바.",
            "en": "What're you looking at? Shiba."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 3,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "안녕하세요.",
            "en": "Hello."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 4,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "하. 이 동네에서 인사하고\n돌아다니는 놈이 있네.",
            "en": "Ha. Someone in this neighborhood\nactually goes around greeting people."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "혹시 인간입니까?",
            "en": "Are you, by any chance, human?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "뭐래, 너 머리 나쁘냐?",
            "en": "What? Are you slow or something?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "육안으로 봤을 때 강아지로 판단됩니다.",
            "en": "Visual assessment indicates: dog."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 8,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "사람을 얼굴로 판단하지 말라고.\n못생긴 놈 같으니.",
            "en": "Don't judge people by their faces,\nyou ugly mug."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 9,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "…그럼 사람이 맞는 건가요?",
            "en": "...So you ARE a person?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 10,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "아니?",
            "en": "Nope?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 11,
          "type": "say",
          "actor": "shiba",
          "arg": "default",
          "text": {
            "ko": "딱 보면 시바잖아, 시바.",
            "en": "One look and you can tell I'm a shiba, shiba."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 12,
          "type": "say",
          "actor": "luna",
          "arg": "default",
          "text": {
            "ko": "아하… 확인했습니다.",
            "en": "I see... confirmed."
          },
          "when": null,
          "effects": "flag.shiba_met = true",
          "sync": "wait"
        }
      ]
    },
