          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 11,
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_011",
          "arg": "idle",
          "text": {
            "ko": "딱 보면 시바잖아, 시바.",
            "en": "One look and you can tell I'm a shiba, shiba."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 12,
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_012",
          "arg": "idle",
          "text": {
            "ko": "아하… 확인했습니다.",
            "en": "I see... confirmed."
          },
          "when": null,
          "effects": "flag.shiba_met = true",
          "sync": "wait"
        }
      ]
