          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 5,
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_005",
          "arg": "idle",
          "text": {
            "ko": "혹시 인간입니까?",
