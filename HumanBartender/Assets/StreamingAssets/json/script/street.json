          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 6,
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_006",
          "arg": "idle",
          "text": {
            "ko": "뭐래, 너 머리 나쁘냐?",
            "en": "What? Are you slow or something?"
