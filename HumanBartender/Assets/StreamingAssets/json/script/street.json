        {
          "seq": 4,
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_004",
          "arg": "idle",
          "text": {
            "ko": "하. 이 동네에서 인사하고\n돌아다니는 놈이 있네.",
