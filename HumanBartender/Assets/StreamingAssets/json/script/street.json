          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 7,
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_007",
          "arg": "idle",
          "text": {
            "ko": "육안으로 봤을 때 강아지로 판단됩니다.",
            "en": "Visual assessment indicates: dog."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 8,
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_008",
          "arg": "idle",
          "text": {
            "ko": "사람을 얼굴로 판단하지 말라고.\n못생긴 놈 같으니.",
            "en": "Don't judge people by their faces,\nyou ugly mug."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 9,
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_009",
          "arg": "idle",
          "text": {
            "ko": "…그럼 사람이 맞는 건가요?",
            "en": "...So you ARE a person?"
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
        {
          "seq": 10,
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_010",
          "arg": "idle",
          "text": {
            "ko": "아니?",
            "en": "Nope?"
