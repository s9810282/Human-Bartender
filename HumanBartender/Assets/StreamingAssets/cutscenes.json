      "type": "comic",
      "blocking": true,
      "background": "black",
      "steps": [
        {
          "time": 0.0,
          "action": "effect",
          "effect_type": "fade_in",
          "duration": 0.3
        },
        {
          "time": 0.3,
          "action": "show_image",
