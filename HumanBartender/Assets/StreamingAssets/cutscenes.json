{
  "position_presets": {
    "full":           { "anchor": "center", "width": 1.0,  "height": 1.0,  "offset_x": 0.0,  "offset_y": 0.0  },
    "center":         { "anchor": "center", "width": 0.8,  "height": 0.8,  "offset_x": 0.0,  "offset_y": 0.0  },
    "center_small":   { "anchor": "center", "width": 0.5,  "height": 0.5,  "offset_x": 0.0,  "offset_y": 0.0  },
    "center_top":     { "anchor": "center", "width": 0.7,  "height": 0.7,  "offset_x": 0.0,  "offset_y": 0.15 },
    "center_bottom":  { "anchor": "center", "width": 0.7,  "height": 0.7,  "offset_x": 0.0,  "offset_y": -0.15},
    "left_panel":     { "anchor": "left",   "width": 0.5,  "height": 1.0,  "offset_x": 0.0,  "offset_y": 0.0  },
    "right_panel":    { "anchor": "right",  "width": 0.5,  "height": 1.0,  "offset_x": 0.0,  "offset_y": 0.0  },
    "left_focus":     { "anchor": "left",   "width": 0.6,  "height": 0.8,  "offset_x": -0.1, "offset_y": 0.0  },
    "right_focus":    { "anchor": "right",  "width": 0.6,  "height": 0.8,  "offset_x": 0.1,  "offset_y": 0.0  },
    "top_left":       { "anchor": "top_left",    "width": 0.35, "height": 0.35, "offset_x": 0.05,  "offset_y": -0.05 },
    "top_right":      { "anchor": "top_right",   "width": 0.35, "height": 0.35, "offset_x": -0.05, "offset_y": -0.05 },
    "bottom_left":    { "anchor": "bottom_left",  "width": 0.35, "height": 0.35, "offset_x": 0.05,  "offset_y": 0.05  },
    "bottom_right":   { "anchor": "bottom_right", "width": 0.35, "height": 0.35, "offset_x": -0.05, "offset_y": 0.05  }
  },

  "layout_presets": {
    "single": {
      "description": "풀스크린 이미지 1장",
      "slots": [
        { "position": "center", "width_override": 1.0, "height_override": 1.0 }
      ]
    },
    "split_2": {
      "description": "좌우 2분할",
      "slots": [
        { "position": "left_panel" },
        { "position": "right_panel" }
      ]
    },
    "split_3_horizontal": {
      "description": "좌/중/우 3분할",
      "slots": [
        { "anchor": "left",   "width": 0.33, "height": 1.0, "offset_x": 0.0, "offset_y": 0.0 },
        { "anchor": "center", "width": 0.34, "height": 1.0, "offset_x": 0.0, "offset_y": 0.0 },
        { "anchor": "right",  "width": 0.33, "height": 1.0, "offset_x": 0.0, "offset_y": 0.0 }
      ]
    },
    "main_left_sub_right": {
      "description": "왼쪽 큰 컷 + 오른쪽 작은 컷 2개",
      "slots": [
        { "anchor": "left",   "width": 0.6, "height": 1.0, "offset_x": 0.0,  "offset_y": 0.0  },
        { "anchor": "right",  "width": 0.4, "height": 0.5, "offset_x": 0.0,  "offset_y": 0.25 },
        { "anchor": "right",  "width": 0.4, "height": 0.5, "offset_x": 0.0,  "offset_y": -0.25 }
      ]
    },
    "stack_vertical": {
      "description": "위아래 2분할",
      "slots": [
        { "anchor": "center", "width": 1.0, "height": 0.5, "offset_x": 0.0, "offset_y": 0.25  },
        { "anchor": "center", "width": 1.0, "height": 0.5, "offset_x": 0.0, "offset_y": -0.25 }
      ]
    },
    "focus_with_bg": {
      "description": "배경 블러 + 가운데 포커스",
      "slots": [
        { "position": "full", "effect": "blur" },
        { "position": "center" }
      ]
    }
  },

  "enter_presets": {
    "cut":          { "description": "즉시 표시 (전환 없음)",       "duration_default": 0.0 },
    "fade_in":      { "description": "투명 → 불투명",              "duration_default": 0.4 },
    "slide_left":   { "description": "오른쪽에서 왼쪽으로 슬라이드", "duration_default": 0.3 },
    "slide_right":  { "description": "왼쪽에서 오른쪽으로 슬라이드", "duration_default": 0.3 },
    "slide_up":     { "description": "아래에서 위로 슬라이드",       "duration_default": 0.3 },
    "slide_down":   { "description": "위에서 아래로 슬라이드",       "duration_default": 0.3 },
    "zoom_in":      { "description": "작은 상태에서 확대 등장",      "duration_default": 0.4 },
    "zoom_out":     { "description": "큰 상태에서 축소 등장",        "duration_default": 0.4 }
  },

  "effect_presets": {
    "fade_in":       { "description": "검은 화면 → 밝아짐" },
    "fade_out":      { "description": "화면 → 어두워짐" },
    "flash_white":   { "description": "순간 하얀 플래시" },
    "screen_shake":  { "description": "화면 흔들림 (intensity = 픽셀)" },
    "zoom_pulse":    { "description": "살짝 확대 후 복귀" },
    "vignette":      { "description": "가장자리 어두워짐" },
    "chromatic":     { "description": "색수차 (RGB 분리) — 글리치/기억 왜곡" }
  },

  "cutscenes": [

    {
      "id": "day1_craft_enter_shake",
