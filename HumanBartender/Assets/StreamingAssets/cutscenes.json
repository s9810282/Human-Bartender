          "enter_duration": 0.4
        },
        {
          "time": 2.0,
          "action": "play_sfx",
          "sfx": "SFX_glass_slide"
        },
        {
          "time": 3.0,
          "action": "effect",
          "effect_type": "fade_out",
          "duration": 0.5
        }
      ]
    },

    {
      "id": "day1_chris_memory_flash",
