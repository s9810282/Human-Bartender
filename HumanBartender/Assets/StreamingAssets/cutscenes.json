        {
          "time": 1.4,
          "action": "show_image",
          "image": "cut_garnish",
          "position": "center",
          "enter": "slide_up",
          "enter_duration": 0.3
        },
        {
          "time": 1.5,
          "action": "play_sfx",
          "sfx": "SFX_garnish_place"
        },
        {
          "time": 2.2,
          "action": "hide_image",
          "image": "cut_garnish",
          "exit": "fade_out",
          "exit_duration": 0.2
        },
        {
          "time": 2.4,
          "action": "show_image",
          "image": "cut_serve_slide",
          "position": "center",
          "enter": "slide_left",
          "enter_duration": 0.3
        },
        {
          "time": 2.5,
          "action": "play_sfx",
          "sfx": "SFX_glass_slide"
        },
        {
          "time": 3.5,
          "action": "effect",
          "effect_type": "fade_out",
          "duration": 0.5
        }
      ]
    },

    {
      "id": "day1_serve_perfect",
