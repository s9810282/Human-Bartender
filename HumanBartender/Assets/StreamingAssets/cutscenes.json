          "time": 0.0,
          "action": "effect",
          "effect_type": "fade_out",
          "duration": 0.3
        },
        {
          "time": 0.4,
          "action": "show_image",
          "image": "cut_shaker_ready",
          "position": "center",
          "enter": "zoom_in",
          "enter_duration": 0.4
        },
        {
          "time": 0.6,
          "action": "play_sfx",
          "sfx": "SFX_shaker_close"
        },
        {
          "time": 1.5,
          "action": "effect",
          "effect_type": "fade_out",
          "duration": 0.3
        }
      ]
    },

    {
      "id": "day1_craft_enter_stir",
