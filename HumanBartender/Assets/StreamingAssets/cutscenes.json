    {
      "id": "day1_serve_default",
      "description": "일반 완성 → 잔에 담고 가니쉬 올리고 손님에게 미는 연출",
      "type": "comic",
      "blocking": true,
      "background": "black",
      "steps": [
        {
          "time": 0.0,
          "action": "effect",
          "effect_type": "fade_in",
          "duration": 0.3
