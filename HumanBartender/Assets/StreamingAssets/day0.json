          "type": "normal",
          "text": "알겠습니다.",
          "expression": null,
          "next": "d0c_end_001_x24",
          "choices": null,
          "trigger": null
        },
        {
          "id": "d0c_end_001_x24",
          "speaker": "chris",
          "type": "normal",
          "text": "밖에서 처음 보는 사람이랑 말하거나 딴 길로 새지 말고 바로 집으로 가.",
          "expression": "default",
          "next": "d0c_end_001_x25",
          "choices": null,
          "trigger": null
        },
