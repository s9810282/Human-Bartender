        },
        {
          "id": "d0c_react_bad_003b",
          "speaker": "chris",
          "type": "normal",
          "text": "뭐가 문제지? 아까부터 자꾸 집중도 안 하고.",
          "expression": "default",
          "next": "d0c_react_bad_004",
          "choices": null,
