    - target: {fileID: 6623656675220914291, guid: 2c6206f7d74aaa3489cc478bbde17840, type: 3}
      propertyPath: m_text
      value: "<color=#eeda01><size=20>\uC9C4\uD53C\uC988</size>- 75$ </color>\n\n\uC81C\uC870
        \uBC29\uBC95: \uC250\uC774\uD0B9_\uC5BC\uC74C \uC5EC\uBD80 : o\n\n\uC9C4\uACFC
        \uC0C1\uD07C\uD55C \uB808\uBAAC\uC774 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uCE75\uD14C\uC77C\uC785\uB2C8\uB2E4.\n\\n\uB300\uBD80\uBD84\uC758
        \uC190\uB2D8\uC774 \uD638\uBD88\uD638 \uC5C6\uC774 \uC990\uAE38 \uC218 \uC788\uB294
        \uBA54\uB274\uC8E0.\n\\n\uC5EC\uB2F4\uC73C\uB85C, \uC9C4 \uD53C\uC988\uC5D0\uC11C
        <color=#eeda01>'\uD53C\uC988'</color>\uB294 \uD0C4\uC0B0\uC774 \uD130\uC9C0\uB294
        \n'\uD53C\uC988 \uD53C\uC988' \uC18C\uB9AC\uB97C \uB530\uC11C \uB9CC\uB4E4\uC5B4\uC84C\uB2E4\uB294
        \uC18D\uC124\uC774 \uC788\uC2B5\uB2C8\uB2E4.\\n\uC774\uC0C1\uD558\uC8E0.
        B-52 \uCE75\uD14C\uC77C\uC5D0\uC11C\uB294 <color=#ee4801>\uD3ED\uD0C4\uC774
        \uB5A8\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB098\uC9C0 \uC54A\uB294\uB370</color>
        \uB9D0\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
