  "choices": [
    {
      "id": "ch_lab_escape_route",
      "prompt_ko": "침입자가 통로를 막고 있다. 어떻게 빠져나갈까?",
      "prompt_en": "The intruder is blocking the passage. How should we escape?",
      "options": [
        {
          "text_ko": "설비 뒤에 숨어 우회한다",
