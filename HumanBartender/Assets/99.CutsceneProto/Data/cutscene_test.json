          "text_en": "Open the containment door with a security keycard",
          "when": "flag.has_keycard",
          "lock_reason_ko": "보안 키카드가 없다",
          "lock_reason_en": "Security keycard required",
          "effects": "flag.route_keycard = true",
          "goto_seq": 90
